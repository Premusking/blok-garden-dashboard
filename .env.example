# WalletConnect Project ID — get one free at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# CoinGecko API key (optional — free tier works without a key but is rate-limited)
VITE_COINGECKO_API_KEY=

# The Graph: BLOK Capital subgraph endpoint on Arbitrum One
# Hosted service (current):
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_SUBGRAPH_ID/blokc-graph/version/latest

# Arbitrum One RPC — use Alchemy/Infura for production, public fallback for dev
VITE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
